# Copy this file to `.env` in the same location and fill in real values.
# NEVER commit the real `.env` file — it is already in .gitignore.
#
# This file covers the BACKEND and DATABASE configuration.
# Frontend-specific variables live in frontend/.env.example (Vite requires
# them to live inside the frontend project and be prefixed with VITE_).

# ---------------------------------------------------------------------------
# Backend server
# ---------------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hackathon_dev
DB_USER=postgres
DB_PASSWORD=changeme

# ---------------------------------------------------------------------------
# CORS / cookies
# ---------------------------------------------------------------------------
# Must be the exact frontend origin the browser navigates to — the backend
# reflects this (not "*") in Access-Control-Allow-Origin because session
# cookies are sent with credentials: "include".
FRONTEND_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# Signs the session cookie (defense-in-depth; sessions are still opaque,
# DB-backed, hashed tokens, not JWTs). Set a long random value outside
# local development — never commit a real value here.
# SESSION_SECRET=
