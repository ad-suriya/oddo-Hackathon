# Copy this file to `.env` in the same location and fill in real values.
# NEVER commit the real `.env` file — it is already in .gitignore.
#
# This file covers the BACKEND and DATABASE configuration.
# Frontend-specific variables live in frontend/.env.example (Vite requires
# them to live inside the frontend project and be prefixed with VITE_).

# ---------------------------------------------------------------------------
# Backend server
# ---------------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hackathon_dev
DB_USER=postgres
DB_PASSWORD=changeme

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# Add secrets (JWT signing key, third-party API keys, etc.) here as they
# become necessary. Do not add a secret to this file with a real value —
# only its name, so teammates know it needs to be set.
# JWT_SECRET=
