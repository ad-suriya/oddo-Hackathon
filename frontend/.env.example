# Copy to `.env` inside frontend/. Vite only exposes variables prefixed
# with VITE_ to client-side code — never put secrets here, this ends up
# in the browser bundle.

VITE_API_BASE_URL=http://localhost:4000/api

# Set to "false" once the backend implements docs/API.md to use the real
# API instead of the in-memory mock layer (src/mocks/). Defaults to true.
VITE_USE_MOCK_API=true
